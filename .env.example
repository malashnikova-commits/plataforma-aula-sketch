# Copia este archivo como .env.local y configura tus valores.
# .env.local esta en .gitignore y nunca se sube a GitHub.

# --- Supabase (Opcional: sincronizacion en nube 24/7)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Plataforma Educativa (Acceso Docente e Identidad)
NEXT_PUBLIC_TUTOR_CODE=
